{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcpjam-flights-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [{ "pattern": "flights.mcpjam.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "EventsDemoSession" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventsDemoSession"] }],
  "ratelimits": [
    {
      "name": "SESSION_LIMIT",
      "namespace_id": "721532101",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "721532102",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
